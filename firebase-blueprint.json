{
  "entities": {
    "BedsheetProduct": {
      "title": "BedsheetProduct",
      "description": "Luxury bedsheet product with specifications, pricing, stock, order sequence, and photography.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for product" },
        "name": { "type": "string", "description": "Product display name" },
        "price": { "type": "number", "description": "Current selling price in INR" },
        "originalPrice": { "type": "number", "description": "Full MRP retail price in INR" },
        "description": { "type": "string", "description": "Detailed artisanal description" },
        "collection": { "type": "string", "description": "Collection category" },
        "image": { "type": "string", "description": "Image URL or compressed data URL" },
        "badge": { "type": "string", "description": "Optional badge text" },
        "inStock": { "type": "boolean", "description": "Availability status" },
        "stockQuantity": { "type": "number", "description": "Inventory units available" },
        "dimensions": { "type": "string", "description": "Bedsheet dimensions" },
        "pillowCovers": { "type": "string", "description": "Pillow cover details" },
        "threadCount": { "type": "string", "description": "Thread count specification" },
        "fabric": { "type": "string", "description": "Fabric material" },
        "pattern": { "type": "string", "description": "Pattern style" },
        "colorTone": { "type": "string", "description": "Color tone description" },
        "features": { "type": "array", "description": "Key feature highlights" },
        "variants": { "type": "array", "description": "Color and design variants" },
        "order": { "type": "number", "description": "Display sort order sequence" },
        "updatedAt": { "type": "number", "description": "Timestamp of last modification" }
      },
      "required": ["id", "name", "price", "originalPrice", "image"]
    },
    "CustomImage": {
      "title": "CustomImage",
      "description": "Permanent store photo uploaded by the owner.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Target bedsheet product ID" },
        "imageUrl": { "type": "string", "description": "Permanent image URL or photo data" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of upload" }
      },
      "required": ["productId", "imageUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order reference ID" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "Customer contact phone" },
        "address": { "type": "string", "description": "Delivery address" },
        "pincode": { "type": "string", "description": "Postal pincode" },
        "items": { "type": "array", "description": "Cart items" },
        "totalAmount": { "type": "number", "description": "Total order amount in INR" },
        "paymentMethod": { "type": "string", "description": "Payment mode" },
        "status": { "type": "string", "description": "Order processing status" },
        "createdAt": { "type": "string", "description": "Order timestamp" }
      },
      "required": ["id", "customerName", "phone", "totalAmount", "status"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Store branding and contact information.",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string", "description": "WhatsApp contact number" },
        "announcement": { "type": "string", "description": "Top announcement banner text" },
        "showAnnouncement": { "type": "boolean", "description": "Show/hide announcement" },
        "updatedAt": { "type": "number", "description": "Timestamp of update" }
      }
    },
    "ThemeConfig": {
      "title": "ThemeConfig",
      "description": "Website active theme and festival color configuration.",
      "type": "object",
      "properties": {
        "activeThemeId": { "type": "string", "description": "Preset or custom theme ID" },
        "themeName": { "type": "string", "description": "Display name of active theme" },
        "colors": { "type": "object", "description": "Color hex values for theme elements" },
        "updatedAt": { "type": "number", "description": "Timestamp of theme publication" },
        "updatedBy": { "type": "string", "description": "Admin email or identifier" }
      },
      "required": ["themeName", "colors"]
    },
    "SeasonalConfig": {
      "title": "SeasonalConfig",
      "description": "Seasonal discount page title, banner, active toggle, and discounted bedsheets.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display name of seasonal festival" },
        "badge": { "type": "string", "description": "Badge label" },
        "bannerTitle": { "type": "string", "description": "Banner headline" },
        "bannerSubtitle": { "type": "string", "description": "Banner subtitle description" },
        "enabled": { "type": "boolean", "description": "Active state determining navbar visibility" },
        "accentColor": { "type": "string", "description": "Highlight color for festival" },
        "discounts": { "type": "array", "description": "List of discounted bedsheets" },
        "updatedAt": { "type": "number", "description": "Timestamp of update" }
      },
      "required": ["name", "enabled"]
    },
    "CouponOffer": {
      "title": "CouponOffer",
      "description": "Storewide and product-specific discount coupon or automated promotional offer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique coupon ID" },
        "code": { "type": "string", "description": "Uppercase promo code entered by customer" },
        "title": { "type": "string", "description": "Display title of the discount offer" },
        "description": { "type": "string", "description": "Terms or details of the coupon" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"], "description": "Type of discount" },
        "discountValue": { "type": "number", "description": "Discount percentage or flat rupees amount" },
        "minOrderValue": { "type": "number", "description": "Minimum subtotal required to qualify" },
        "maxDiscountAmount": { "type": "number", "description": "Maximum rupee cap for percentage discounts" },
        "startDate": { "type": "string", "description": "ISO start date string" },
        "expiryDate": { "type": "string", "description": "ISO expiry date string" },
        "isActive": { "type": "boolean", "description": "Whether coupon is active" },
        "isAutomatic": { "type": "boolean", "description": "Whether coupon auto-applies without entering code" },
        "maxUses": { "type": "number", "description": "Maximum redemptions allowed across all users" },
        "usedCount": { "type": "number", "description": "Number of times this coupon has been used" },
        "oneUsePerCustomer": { "type": "boolean", "description": "Restrict to 1 redemption per customer" },
        "usedByCustomers": { "type": "array", "description": "List of customer phones/emails that used coupon" },
        "scope": { "type": "string", "enum": ["all", "products", "collections"], "description": "Target scope" },
        "applicableProductIds": { "type": "array", "description": "Specific product IDs coupon applies to" },
        "badgeText": { "type": "string", "description": "Pill tag text shown next to code" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "updatedAt": { "type": "number", "description": "Timestamp of last edit" }
      },
      "required": ["id", "code", "title", "discountType", "discountValue", "expiryDate", "isActive"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "BedsheetProduct",
      "description": "Store bedsheets catalog items"
    },
    "/custom_images/{productId}": {
      "schema": "CustomImage",
      "description": "Permanent uploaded photos for products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders"
    },
    "/site_content/{contentId}": {
      "schema": "SiteContent",
      "description": "Store contact and banner details"
    },
    "/theme/{themeId}": {
      "schema": "ThemeConfig",
      "description": "Storewide active website theme configuration"
    },
    "/seasonal/{seasonalId}": {
      "schema": "SeasonalConfig",
      "description": "Seasonal discount page and festive offers configuration"
    },
    "/coupons/{couponId}": {
      "schema": "CouponOffer",
      "description": "Store promotional coupons and automatic discount offers"
    }
  }
}
