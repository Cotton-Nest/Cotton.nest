{
  "entities": {
    "BedsheetProduct": {
      "title": "BedsheetProduct",
      "description": "Luxury bedsheet product with specifications, pricing, stock, order sequence, and photography.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for product" },
        "name": { "type": "string", "description": "Product display name" },
        "price": { "type": "number", "description": "Current selling price in INR" },
        "originalPrice": { "type": "number", "description": "Full MRP retail price in INR" },
        "description": { "type": "string", "description": "Detailed artisanal description" },
        "collection": { "type": "string", "description": "Collection category" },
        "image": { "type": "string", "description": "Primary image or video URL" },
        "additionalImages": { "type": "array", "description": "Extra gallery angle photos and video reels" },
        "videos": { "type": "array", "description": "Product showcase video URLs" },
        "videoUrl": { "type": "string", "description": "Featured product video URL" },
        "badge": { "type": "string", "description": "Optional badge text" },
        "inStock": { "type": "boolean", "description": "Availability status" },
        "stockQuantity": { "type": "number", "description": "Inventory units available" },
        "dimensions": { "type": "string", "description": "Bedsheet dimensions" },
        "pillowCovers": { "type": "string", "description": "Pillow cover details" },
        "threadCount": { "type": "string", "description": "Thread count specification" },
        "fabric": { "type": "string", "description": "Fabric material" },
        "pattern": { "type": "string", "description": "Pattern style" },
        "colorTone": { "type": "string", "description": "Color tone description" },
        "features": { "type": "array", "description": "Key feature highlights" },
        "variants": { "type": "array", "description": "Color and design variants" },
        "order": { "type": "number", "description": "Display sort order sequence" },
        "updatedAt": { "type": "number", "description": "Timestamp of last modification" }
      },
      "required": ["id", "name", "price", "originalPrice", "image"]
    },
    "CustomImage": {
      "title": "CustomImage",
      "description": "Permanent store photo uploaded by the owner.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Target bedsheet product ID" },
        "imageUrl": { "type": "string", "description": "Permanent image URL or photo data" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of upload" }
      },
      "required": ["productId", "imageUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order reference ID" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "Customer contact phone" },
        "address": { "type": "string", "description": "Delivery address" },
        "pincode": { "type": "string", "description": "Postal pincode" },
        "items": { "type": "array", "description": "Cart items" },
        "totalAmount": { "type": "number", "description": "Total order amount in INR" },
        "paymentMethod": { "type": "string", "description": "Payment mode" },
        "status": { "type": "string", "description": "Order processing status" },
        "deliveredAt": { "type": "string", "description": "ISO timestamp when order was delivered" },
        "createdAt": { "type": "string", "description": "Order timestamp" }
      },
      "required": ["id", "customerName", "phone", "totalAmount", "status"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Store branding, shipping fee, and contact information.",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string", "description": "WhatsApp contact number" },
        "announcement": { "type": "string", "description": "Top announcement banner text" },
        "showAnnouncement": { "type": "boolean", "description": "Show/hide announcement" },
        "shippingFeeIndia": { "type": "number", "description": "Across India standard courier shipping charge in INR (default 29)" },
        "updatedAt": { "type": "number", "description": "Timestamp of update" }
      }
    },
    "ThemeConfig": {
      "title": "ThemeConfig",
      "description": "Website active theme, Liquid Glass opacity/blur, and festival color configuration.",
      "type": "object",
      "properties": {
        "activeThemeId": { "type": "string", "description": "Preset or custom theme ID" },
        "themeName": { "type": "string", "description": "Display name of active theme" },
        "glassOpacity": { "type": "number", "description": "Liquid Glass surface opacity (0.10 to 0.95)" },
        "glassBlur": { "type": "number", "description": "Liquid Glass optical backdrop blur in pixels (8 to 44)" },
        "colors": { "type": "object", "description": "Color hex values and glass settings for theme elements" },
        "updatedAt": { "type": "number", "description": "Timestamp of theme publication" },
        "updatedBy": { "type": "string", "description": "Admin email or identifier" }
      },
      "required": ["themeName", "colors"]
    },
    "SeasonalConfig": {
      "title": "SeasonalConfig",
      "description": "Seasonal discount page title, banner, active toggle, and discounted bedsheets.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display name of seasonal festival" },
        "badge": { "type": "string", "description": "Badge label" },
        "bannerTitle": { "type": "string", "description": "Banner headline" },
        "bannerSubtitle": { "type": "string", "description": "Banner subtitle description" },
        "enabled": { "type": "boolean", "description": "Active state determining navbar visibility" },
        "accentColor": { "type": "string", "description": "Highlight color for festival" },
        "discounts": { "type": "array", "description": "List of discounted bedsheets" },
        "updatedAt": { "type": "number", "description": "Timestamp of update" }
      },
      "required": ["name", "enabled"]
    },
    "CouponOffer": {
      "title": "CouponOffer",
      "description": "Storewide and product-specific discount coupon or automated promotional offer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique coupon ID" },
        "code": { "type": "string", "description": "Uppercase promo code entered by customer" },
        "title": { "type": "string", "description": "Display title of the discount offer" },
        "description": { "type": "string", "description": "Terms or details of the coupon" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"], "description": "Type of discount" },
        "discountValue": { "type": "number", "description": "Discount percentage or flat rupees amount" },
        "minOrderValue": { "type": "number", "description": "Minimum subtotal required to qualify" },
        "maxDiscountAmount": { "type": "number", "description": "Maximum rupee cap for percentage discounts" },
        "startDate": { "type": "string", "description": "ISO start date string" },
        "expiryDate": { "type": "string", "description": "ISO expiry date string" },
        "isActive": { "type": "boolean", "description": "Whether coupon is active" },
        "isAutomatic": { "type": "boolean", "description": "Whether coupon auto-applies without entering code" },
        "maxUses": { "type": "number", "description": "Maximum redemptions allowed across all users" },
        "usedCount": { "type": "number", "description": "Number of times this coupon has been used" },
        "oneUsePerCustomer": { "type": "boolean", "description": "Restrict to 1 redemption per customer" },
        "usedByCustomers": { "type": "array", "description": "List of customer phones/emails that used coupon" },
        "scope": { "type": "string", "enum": ["all", "products", "collections"], "description": "Target scope" },
        "applicableProductIds": { "type": "array", "description": "Specific product IDs coupon applies to" },
        "badgeText": { "type": "string", "description": "Pill tag text shown next to code" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "updatedAt": { "type": "number", "description": "Timestamp of last edit" }
      },
      "required": ["id", "code", "title", "discountType", "discountValue", "expiryDate", "isActive"]
    },
    "CustomerWishlist": {
      "title": "CustomerWishlist",
      "description": "Bedsheet items saved to a customer wishlist with customer contact information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique id combining customerId and productId" },
        "customerId": { "type": "string", "description": "Identifier of the customer" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerEmail": { "type": "string", "description": "Optional customer email" },
        "customerPhone": { "type": "string", "description": "Optional customer phone/WhatsApp" },
        "productId": { "type": "string", "description": "Target product ID" },
        "productName": { "type": "string", "description": "Product title" },
        "productPrice": { "type": "number", "description": "Price in INR" },
        "productOriginalPrice": { "type": "number", "description": "MRP in INR" },
        "productImage": { "type": "string", "description": "Product image URL" },
        "productDimensions": { "type": "string", "description": "Dimensions" },
        "collection": { "type": "string", "description": "Collection name" },
        "threadCount": { "type": "string", "description": "Thread count" },
        "fabric": { "type": "string", "description": "Fabric material" },
        "selectedVariantId": { "type": "string", "description": "Optional selected variant ID" },
        "selectedVariantName": { "type": "string", "description": "Optional selected variant name" },
        "note": { "type": "string", "description": "Optional customer note" },
        "createdAt": { "type": "number", "description": "Timestamp when wishlisted" }
      },
      "required": ["id", "customerId", "customerName", "productId", "productName", "productPrice", "productImage", "createdAt"]
    },
    "LoyaltyAccount": {
      "title": "LoyaltyAccount",
      "description": "Customer loyalty reward points balance and account information (1 point per 50 Rs spent)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique loyalty account key (userId, phone, or email)" },
        "userId": { "type": "string", "description": "Associated Firebase auth user ID if signed in" },
        "email": { "type": "string", "description": "Associated customer email" },
        "phone": { "type": "string", "description": "Associated customer mobile/WhatsApp number" },
        "customerName": { "type": "string", "description": "Customer display name" },
        "pointsBalance": { "type": "number", "description": "Current active points balance" },
        "lifetimeEarned": { "type": "number", "description": "Total cumulative points earned across all orders" },
        "lifetimeSpent": { "type": "number", "description": "Total cumulative points redeemed as discounts" },
        "updatedAt": { "type": "number", "description": "Timestamp of last balance change" }
      },
      "required": ["id", "pointsBalance", "lifetimeEarned", "lifetimeSpent", "updatedAt"]
    },
    "LoyaltyTransaction": {
      "title": "LoyaltyTransaction",
      "description": "Ledger entry for points earned from purchases or redeemed as checkout discounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction ID" },
        "accountId": { "type": "string", "description": "Loyalty account identifier" },
        "orderId": { "type": "string", "description": "Related order ID" },
        "type": { "type": "string", "enum": ["earned", "redeemed", "bonus", "adjustment"], "description": "Type of points movement" },
        "points": { "type": "number", "description": "Points value delta (positive or negative)" },
        "amountInr": { "type": "number", "description": "Rupee value associated with order or discount" },
        "description": { "type": "string", "description": "Human readable ledger note" },
        "createdAt": { "type": "number", "description": "Transaction timestamp" }
      },
      "required": ["id", "accountId", "type", "points", "description", "createdAt"]
    },
    "AnalyticsData": {
      "title": "AnalyticsData",
      "description": "Store website traffic, visitors, page views, and engagement metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Identifier for analytics doc (e.g. site_traffic)" },
        "totalVisits": { "type": "number", "description": "Total cumulative page visits" },
        "uniqueVisitors": { "type": "number", "description": "Unique session count" },
        "pageViewsByDate": { "type": "object", "description": "Date-wise page views count map" },
        "pageViewsBySection": { "type": "object", "description": "Section-wise visit distribution" },
        "deviceBreakdown": { "type": "object", "description": "Distribution across mobile, desktop, and tablet" },
        "lastVisitedAt": { "type": "number", "description": "Timestamp of most recent page hit" }
      },
      "required": ["id", "totalVisits", "uniqueVisitors", "lastVisitedAt"]
    },
    "CustomerActivityProfile": {
      "title": "CustomerActivityProfile",
      "description": "Individual signed-in customer activity profile, session logs, product views, wishlist history, cart activity, search terms, device specs, and chronological timeline.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique customer Firebase UID or sanitized account identifier" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "email": { "type": "string", "description": "Registered email address" },
        "phone": { "type": "string", "description": "Customer phone number if available" },
        "accountCreatedAt": { "type": "number", "description": "Account creation epoch timestamp" },
        "lastLoginAt": { "type": "number", "description": "Most recent login timestamp" },
        "lastLogoutAt": { "type": "number", "description": "Most recent logout timestamp" },
        "lastActiveAt": { "type": "number", "description": "Most recent active interaction timestamp" },
        "totalSessions": { "type": "number", "description": "Total number of login sessions" },
        "totalTimeSpentSeconds": { "type": "number", "description": "Cumulative active seconds spent on website" },
        "averageSessionDurationSeconds": { "type": "number", "description": "Average session duration in seconds" },
        "totalPagesVisited": { "type": "number", "description": "Cumulative pages visited" },
        "mostVisitedPage": { "type": "string", "description": "Most frequently visited section" },
        "totalProductViews": { "type": "number", "description": "Total product views count" },
        "productsViewed": { "type": "array", "description": "List of viewed products with counts and timestamps" },
        "totalAddedToCartCount": { "type": "number", "description": "Total products added to cart" },
        "totalAddedToWishlistCount": { "type": "number", "description": "Historical count of wishlist additions" },
        "currentWishlist": { "type": "array", "description": "Currently saved wishlist products" },
        "historicalWishlist": { "type": "array", "description": "All products ever added to wishlist by customer" },
        "totalSearches": { "type": "number", "description": "Total searches performed" },
        "searchHistory": { "type": "array", "description": "Search terms and timestamps" },
        "ordersPlacedCount": { "type": "number", "description": "Total orders placed" },
        "totalPurchaseValue": { "type": "number", "description": "Cumulative purchase value in INR" },
        "deviceInfo": { "type": "object", "description": "Device type, OS, browser, screen resolution, and approximate region" },
        "sessions": { "type": "array", "description": "Session-wise activity logs" },
        "timeline": { "type": "array", "description": "Chronological activity events" },
        "updatedAt": { "type": "number", "description": "Last profile flush timestamp" }
      },
      "required": ["uid", "customerName", "lastActiveAt", "totalSessions", "totalTimeSpentSeconds"]
    },
    "WelcomeOfferConfig": {
      "title": "WelcomeOfferConfig",
      "description": "Configuration for the Welcome to Cotton Nest 10% OFF first-order offer",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether the Welcome Offer is active" },
        "offerName": { "type": "string", "description": "Name of the offer (Welcome to Cotton Nest)" },
        "discountPercentage": { "type": "number", "description": "Discount percentage (default 10)" },
        "minOrderValue": { "type": "number", "description": "Minimum eligible product subtotal (default 1299)" },
        "maxDiscountAmount": { "type": "number", "description": "Maximum discount cap in INR (default 200)" },
        "updatedAt": { "type": "number", "description": "Last configuration update timestamp" }
      },
      "required": ["enabled", "offerName", "discountPercentage", "minOrderValue", "maxDiscountAmount", "updatedAt"]
    },
    "WelcomeOfferRedemption": {
      "title": "WelcomeOfferRedemption",
      "description": "Tracks customer eligibility, reservation, and one-time redemption of the Welcome to Cotton Nest offer by Firebase UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Customer Firebase UID" },
        "email": { "type": "string", "description": "Customer Google email" },
        "customerName": { "type": "string", "description": "Customer display name" },
        "phone": { "type": "string", "description": "Customer mobile number" },
        "authProvider": { "type": "string", "description": "Authentication provider (google)" },
        "status": { "type": "string", "enum": ["eligible", "reserved", "redeemed", "ineligible_existing_customer", "ineligible_not_google_auth"], "description": "Current offer eligibility/redemption state" },
        "reservedOrderId": { "type": "string", "description": "Order ID that currently reserves the offer" },
        "reservedAt": { "type": "number", "description": "Timestamp when offer was reserved" },
        "redeemedOrderId": { "type": "string", "description": "Order ID that permanently redeemed the offer upon delivery" },
        "redeemedAt": { "type": "number", "description": "Timestamp when offer was permanently redeemed" },
        "discountAmount": { "type": "number", "description": "Discount amount applied in INR" },
        "popupShownAt": { "type": "number", "description": "Timestamp when welcome popup was shown to customer" },
        "updatedAt": { "type": "number", "description": "Last status update timestamp" }
      },
      "required": ["uid", "status", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "BedsheetProduct",
      "description": "Store bedsheets catalog items"
    },
    "/custom_images/{productId}": {
      "schema": "CustomImage",
      "description": "Permanent uploaded photos for products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders"
    },
    "/site_content/{contentId}": {
      "schema": "SiteContent",
      "description": "Store contact and banner details"
    },
    "/theme/{themeId}": {
      "schema": "ThemeConfig",
      "description": "Storewide active website theme configuration"
    },
    "/seasonal/{seasonalId}": {
      "schema": "SeasonalConfig",
      "description": "Seasonal discount page and festive offers configuration"
    },
    "/coupons/{couponId}": {
      "schema": "CouponOffer",
      "description": "Store promotional coupons and automatic discount offers"
    },
    "/wishlists/{wishlistId}": {
      "schema": "CustomerWishlist",
      "description": "Customer wishlists storing saved items with contact details"
    },
    "/loyalty/{accountId}": {
      "schema": "LoyaltyAccount",
      "description": "Customer loyalty reward points accounts and balances"
    },
    "/loyalty_transactions/{txId}": {
      "schema": "LoyaltyTransaction",
      "description": "Ledger records of points earned and redeemed"
    },
    "/analytics/{docId}": {
      "schema": "AnalyticsData",
      "description": "Aggregated store traffic and analytics metrics"
    },
    "/customer_activity/{userId}": {
      "schema": "CustomerActivityProfile",
      "description": "Individual signed-in customer activity profiles and session analytics"
    },
    "/welcome_offer/{docId}": {
      "schema": "WelcomeOfferConfig",
      "description": "Welcome to Cotton Nest 10% OFF offer configuration"
    },
    "/welcome_offer_redemptions/{uid}": {
      "schema": "WelcomeOfferRedemption",
      "description": "Per-customer Welcome Offer eligibility, reservation, and redemption records"
    }
  }
}
