# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Firebase & Google Identity Services (GIS) SDK
FIREBASE_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Cloudinary (Optional - for persistent remote image hosting)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

# App Configuration
APP_URL=

# Gmail SMTP Email OTP Verification (Backend Only - Never expose in VITE_ client variables)
# Host: smtp.gmail.com | Port: 465 (SSL)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx