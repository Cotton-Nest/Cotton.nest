rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adityaa.22082011@gmail.com' ||
        request.auth.token.email_verified == true
      );
    }

    // Products catalog: readable by all visitors, writable by store management
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // Custom permanent photos: readable by all visitors, writable by store management
    match /custom_images/{productId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // Orders: readable by store management, creatable by checkout
    match /orders/{orderId} {
      allow read: if isOwnerOrAdmin();
      allow create: if true;
      allow update, delete: if isOwnerOrAdmin();
    }

    // Customer Reviews: readable by all visitors, creatable by customers
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isOwnerOrAdmin();
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Store branding, theme appearance, and announcements
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // Website Appearance & Festival Theme configuration
    match /theme/{themeId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // Seasonal discount offers & banner
    match /seasonal/{seasonalId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }
  }
}
