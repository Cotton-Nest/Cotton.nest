rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly verifies authorized Cotton Nest store owner / admin emails
    function isOwnerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email.toLowerCase() == 'adityaa.451485@gmail.com' ||
        request.auth.token.email.toLowerCase() == 'adityaa.22082011@gmail.com' ||
        request.auth.token.email.toLowerCase() == 'cottonnest.atelier@gmail.com'
      );
    }

    // Products catalog: readable by all, manageable only by authorized owners/admins
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Custom permanent photos: readable by all, manageable only by authorized owners/admins
    match /custom_images/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Photo statistics and updated image counts
    match /custom_images_stats/{docId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // Orders: strictly isolated by owner UID. Customers access only their own orders; admins access all
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwnerOrAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isOwnerOrAdmin());
      allow update: if isOwnerOrAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.totalAmount == resource.data.totalAmount
      );
      allow delete: if isOwnerOrAdmin();
    }

    // Customer Reviews: readable by all visitors, submission allowed, deletion restricted to admins
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isOwnerOrAdmin();
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Store branding, theme appearance, and announcements
    match /site_content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Dynamic Homepage Campaign Banners: public read for store visitors, full management for authorized admins
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Website Appearance & Festival Theme configuration
    match /theme/{themeId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Seasonal discount offers & banner
    match /seasonal/{seasonalId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Coupons & Promotional Offers
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Customer & Admin Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Back-in-Stock product subscriptions
    match /stock_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Web Push Subscriptions
    match /push_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Customer Wishlists: curated bedsheets saved by individual visitors
    match /wishlists/{wishlistId} {
      allow read, write: if true;
    }

    // Customer Loyalty Points & Rewards
    match /loyalty/{accountId} {
      allow read, write: if true;
    }

    // Customer Loyalty Ledger Transactions
    match /loyalty_transactions/{txId} {
      allow read, write: if true;
    }

    // Website Traffic & Store Analytics
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // Signed-in Customer Activity Profiles & Session Analytics
    match /customer_activity/{userId} {
      allow read: if isOwnerOrAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if (isSignedIn() && request.auth.uid == userId) || isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();
    }

    // Welcome Offer Configuration
    match /welcome_offer/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // Per-Customer Welcome Offer Eligibility & Redemption Records
    match /welcome_offer_redemptions/{uid} {
      allow read: if isOwnerOrAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isOwnerOrAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isOwnerOrAdmin();
    }
  }
}
