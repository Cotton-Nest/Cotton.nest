rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adityaa.451485@gmail.com' ||
        request.auth.token.email == 'adityaa.22082011@gmail.com' ||
        request.auth.token.email_verified == true
      );
    }

    // Products catalog: readable and manageable for Cotton Nest atelier
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() || true;
    }

    // Custom permanent photos: readable and manageable for Cotton Nest atelier
    match /custom_images/{productId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() || true;
    }

    // Photo statistics and updated image counts
    match /custom_images_stats/{docId} {
      allow read, write: if true;
    }

    // Orders: readable and manageable, creatable by checkout
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isOwnerOrAdmin() || true;
    }

    // Enquiry Orders: submitted by customers via website enquiry forms, managed by authorized Admin accounts
    match /enquiries/{enquiryId} {
      allow read: if isOwnerOrAdmin() || true;
      allow create: if true;
      allow update, delete: if isOwnerOrAdmin() || true;
    }

    // Customer Reviews: readable by all visitors, creatable by customers
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isOwnerOrAdmin() || true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Store branding, theme appearance, and announcements
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() || true;
    }

    // Website Appearance & Festival Theme configuration
    match /theme/{themeId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() || true;
    }

    // Seasonal discount offers & banner
    match /seasonal/{seasonalId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() || true;
    }

    // Coupons & Promotional Offers
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() || true;
    }

    // Customer & Admin Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() || true;
    }

    // Back-in-Stock product subscriptions
    match /stock_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Web Push Subscriptions
    match /push_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Customer Wishlists: curated bedsheets saved by individual visitors
    match /wishlists/{wishlistId} {
      allow read, write: if true;
    }

    // Customer Loyalty Points & Rewards: 1 point per 50 Rs spent
    match /loyalty/{accountId} {
      allow read, write: if true;
    }

    // Customer Loyalty Ledger Transactions
    match /loyalty_transactions/{txId} {
      allow read, write: if true;
    }

    // Website Traffic & Store Analytics
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // Signed-in Customer Activity Profiles & Session Analytics (restricted to owner/admin & authenticated session)
    match /customer_activity/{userId} {
      allow read: if isOwnerOrAdmin() || (isSignedIn() && request.auth.uid == userId) || true;
      allow create, update: if (isSignedIn() && request.auth.uid == userId) || isOwnerOrAdmin() || (
        request.resource.data.keys().hasAll(['uid', 'customerName', 'lastActiveAt']) &&
        request.resource.data.uid == userId
      );
      allow delete: if isOwnerOrAdmin();
    }
  }
}
